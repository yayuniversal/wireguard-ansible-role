{% macro multivalues(param_name, values) -%}
{%- for value in values -%}
{{ param_name }} = {{ value }}
{% endfor %}
{%- endmacro -%}

[Interface]
Address = {{ wg_interface.ip_address }}
PrivateKey = {{ _wireguard_private_key }}
ListenPort = {{ wg_interface.listen_port }}
{% if wg_interface.dns %}DNS = {{ wg_interface.dns }}
{% endif %}
{% if wg_interface.mtu %}MTU = {{ wg_interface.mtu }}
{% endif %}
{{ multivalues("PreUp", wg_interface.preup | enforce_list) -}}
{{ multivalues("PostUp", wg_interface.postup | enforce_list) -}}
{{ multivalues("PreDown", wg_interface.predown | enforce_list) -}}
{{ multivalues("PostDown", wg_interface.postdown | enforce_list)  }}

{% for peer in wg_interface.peers %}
{% if peer.name is defined %}# {{ peer.name }}
{% endif %}
[Peer]
AllowedIPs = {{ ", ".join(peer.allowed_ips) if peer.allowed_ips is iterable and peer.allowed_ips is not string else peer.allowed_ips }}
PublicKey = {{ peer.public_key }}
{% if peer.psk is defined %}PresharedKey = {{ peer.psk }}
{% endif %}
{% if peer.endpoint is defined %}Endpoint = {{ peer.endpoint }}
{% endif %}
{% if peer.keepalive is defined %}PersistentKeepalive = {{ peer.keepalive }}
{% endif %}

{% endfor %}
